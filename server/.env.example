# Salin file ini jadi .env dan isi nilai sebenarnya. JANGAN PERNAH commit
# file .env yang sudah terisi ke git (sudah ada di .gitignore).

# Port HTTP server ini mendengarkan (Railway inject otomatis via env PORT).
PORT=8080

# --- PostgreSQL (Railway Postgres) ---
# Railway otomatis inject DATABASE_URL dari Postgres add-on ke service ini.
# Untuk lokal, isi dengan connection string Postgres lu sendiri, mis:
# DATABASE_URL=postgres://user:pass@localhost:5432/trimharvest
DATABASE_URL=postgres://user:pass@localhost:5432/trimharvest

# --- JWT (autentikasi app Flutter, lihat /PROTOCOL.md bagian 3) ---
# Generate nilai acak panjang: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=GANTI-DENGAN-STRING-ACAK-PANJANG
JWT_REFRESH_SECRET=GANTI-DENGAN-STRING-ACAK-PANJANG-BERBEDA
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Toleransi jendela waktu tanda tangan request gateway (ms) ---
# HARUS SAMA dengan REQUEST_TIMESTAMP_WINDOW_MS di gateway-rumah/src/config.h.
REQUEST_TIMESTAMP_WINDOW_MS=120000

# --- Retensi data sensor (hari) ---
# Masa retensi baris tabel `readings` sebelum otomatis dihapus (field
# expire_at). Default 90. Atur 0 kalau mau simpan selamanya (TIDAK
# direkomendasikan untuk produksi jangka panjang -- biaya & latensi query naik).
READINGS_TTL_DAYS=90

# --- CORS: daftar origin browser yang diizinkan (pisah koma) ---
# Contoh: "https://app.trimharvest.id,https://web.trimharvest.id"
# Kosong = izinkan semua (HANYA untuk development). PRODUCTION WAJIB diisi.
ALLOWED_ORIGINS=

# --- Logging ---
LOG_LEVEL=info
