rules_version = '2';

// Firestore ini HANYA pernah diakses lewat Firebase Admin SDK dari server
// (lihat src/lib/firebaseAdmin.js) -- Admin SDK memakai service account
// dan SECARA DESAIN melewati (bypass) security rules di bawah ini sama
// sekali. Rules ini TETAP dipasang sebagai lapisan pertahanan kedua: kalau
// suatu saat ada yang tidak sengaja menaruh Firebase client config (API
// key publik dkk) di app/firmware, client itu TETAP tidak akan bisa
// membaca/menulis apa pun ke database ini.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
